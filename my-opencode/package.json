{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "my-opencode",
  "description": "Re-implementation of opencode for learning",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd packages/my-cli src/index.ts",
    "typecheck": "bun turbo typecheck",
    "lint": "oxlint"
  },
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "@types/bun": "1.3.13",
      "@typescript/native-preview": "7.0.0-dev.20251207.1"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "oxlint": "1.60.0",
    "turbo": "2.10.2",
    "typescript": "5.8.2"
  }
}
