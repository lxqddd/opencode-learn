{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "my-opencode",
  "description": "Re-implementation of opencode for learning",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd packages/my-cli src/index.ts",
    "tui": "bun run --cwd packages/my-cli src/index.ts tui",
    "typecheck": "bun turbo typecheck",
    "lint": "oxlint"
  },
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "@ai-sdk/openai-compatible": "2.0.41",
      "@opentui/core": "0.4.5",
      "@opentui/keymap": "0.4.5",
      "@opentui/solid": "0.4.5",
      "@types/bun": "1.3.13",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "ai": "6.0.168",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.83",
      "solid-js": "1.9.10",
      "ulid": "3.0.1"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "oxlint": "1.60.0",
    "turbo": "2.10.2",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "effect": "3.22.1"
  }
}
